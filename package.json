{
  "name": "kie-image-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "Kie internal product concept image generator",
  "author": "Internal",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "desktop:prepare": "node scripts/prepare-standalone.mjs",
    "desktop:pack": "next build && npm run desktop:prepare && electron-builder --win portable",
    "desktop:dev": "concurrently -k \"next dev\" \"wait-on http://127.0.0.1:3000 && electron .\""
  },
  "build": {
    "appId": "com.internal.kie-workbench",
    "productName": "KieWorkbench",
    "directories": {
      "output": "release"
    },
    "files": ["electron/**/*", "package.json"],
    "extraResources": [
      {
        "from": "dist-standalone",
        "to": "server",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": ["portable"],
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  },
  "dependencies": {
    "@vercel/blob": "^0.27.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "wait-on": "^8.0.1"
  }
}
